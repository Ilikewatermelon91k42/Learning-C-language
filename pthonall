class maths1:
  @staticmethod
  def add1():
    a=int(input("Enter 1 number-->"))
    b=int(input("Enter 1 number-->"))
    print(a,"+",b,"=",a+b)
  @staticmethod
  def sub1():
    a=int(input("Enter 1 number-->"))
    b=int(input("Enter 1 number-->"))
    print(a,"-",b,"=",a-b)
  @staticmethod
  def mul1():
    a=int(input("Enter 1 number-->"))
    b=int(input("Enter 1 number-->"))
    print(a,"X",b,"=",a*b)
  @staticmethod
  def div1():
    a=int(input("Enter 1 number-->"))
    b=int(input("Enter 1 number-->"))
    print(a,"/",b,"=",a/b)
